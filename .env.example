# Example values only. Do not commit real credentials.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-in-local-env
POSTGRES_DB=inventory_sales_dev
POSTGRES_USER=inventory_dev
POSTGRES_PASSWORD=replace-in-local-env
DATABASE_HOST=db
DATABASE_PORT=5432

# Published host ports; container service ports remain fixed.
BACKEND_PORT=8000
FRONTEND_PORT=5173
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# Standalone Django defaults to console email. Compose selects Mailpit SMTP.
# For standalone SMTP capture, set DJANGO_EMAIL_BACKEND to
# django.core.mail.backends.smtp.EmailBackend in your shell, EMAIL_HOST=127.0.0.1
# and EMAIL_PORT=1025. Compose supplies mailpit:1025 automatically.
